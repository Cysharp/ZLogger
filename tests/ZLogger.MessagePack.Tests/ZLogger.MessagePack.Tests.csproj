<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Microsoft.Testing.Platform -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kept at 5.10.3 as before Central Package Management; FluentAssertions is to be replaced, so it is not aligned with the 6.7.0 of the other tests. -->
    <PackageReference Include="FluentAssertions" VersionOverride="5.10.3" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
   <ProjectReference Include="..\..\src\ZLogger.MessagePack\ZLogger.MessagePack.csproj" />
   <ProjectReference Include="..\..\src\ZLogger\ZLogger.csproj" />
   <ProjectReference Include="..\ZLogger.MessagePack.Tests.NetStandardTypes\ZLogger.MessagePack.Tests.NetStandardTypes.csproj" />
   <ProjectReference Include="..\..\src\ZLogger.Generator\ZLogger.Generator.csproj">
     <OutputItemType>Analyzer</OutputItemType>
     <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
   </ProjectReference>
  </ItemGroup>
</Project>
